# Swedavia API (dlt)
SWEDAVIA_API_KEY=...

# Snowflake account (dbt)
SNOWFLAKE_ACCOUNT=...

# transformer user (dbt, via profiles.yml)
SNOWFLAKE_USER_TRANSFORMER_PASSWORD=...

# extract_loader user (dlt). The rest of the credentials are in dlt_code/.dlt/config.toml
DESTINATION__SNOWFLAKE__CREDENTIALS__HOST=...
DESTINATION__SNOWFLAKE__CREDENTIALS__PASSWORD=...
DESTINATION__SNOWFLAKE__CREDENTIALS__DATABASE=FLIGHTS
DESTINATION__SNOWFLAKE__CREDENTIALS__USERNAME=extract_loader
DESTINATION__SNOWFLAKE__CREDENTIALS__WAREHOUSE=FLIGHTS_WH
DESTINATION__SNOWFLAKE__CREDENTIALS__ROLE=FLIGHTS_DLT_ROLE

# Dagster (local only, overridden in docker-compose)
# Replace ... with the absolute path to your local repo
DAGSTER_HOME=.../Flight_Punctuality_Analytics_Lab/.dagster_home
# Windows only: shows print output in the Dagster UI
PYTHONLEGACYWINDOWSSTDIO=1

# Dashboard (reads from marts)
SNOWFLAKE_USER=...
SNOWFLAKE_PASSWORD=...
SNOWFLAKE_WAREHOUSE=FLIGHTS_WH
SNOWFLAKE_DATABASE=FLIGHTS
SNOWFLAKE_SCHEMA=MARTS
SNOWFLAKE_ROLE=...