Table fct_arivals {
  airline_id VARCHAR [not null, ref: > dim_airline.airline_id]
  arrival_airport_id VARCHAR [not null, ref: > dim_airport.airport_id]
  departure_airport_id VARCHAR [not null, ref: > dim_airport.airport_id]
  date_id VARCHAR [not null, ref: > dim_date.date_id]
  flight_id VARCHAR(6) [not null] //flight_id
  has_via_destinations BOOL [not null] //arrivals__via_destinations   
  type_of_flights VARCHAR(1) [not null] //di_indicator , (domestic (D), international (I) or Schengen (S))
  arrival_time_scheduled_utc DATETIME [not null] //arrival_time__schedule_utc
  arrival_time_estimated_utc DATETIME //arrival_time_estimated_utc
  arrival_time_actual_utc DATETIME //arrival_time__actual_utc
  terminal VARCHAR(2) //location_and_status__terminal
}

Table fct_departures {
  airline_id VARCHAR [not null, ref: > dim_airline.airline_id]
  arrival_airport_id VARCHAR [not null, ref: > dim_airport.airport_id]
  departure_airport_id VARCHAR [not null, ref: > dim_airport.airport_id]
  date_id VARCHAR [not null, ref: > dim_date.date_id]
  flight_id VARCHAR(6) [not null] //flight_id
  has_via_destinations BOOL [not null] //departures__via_destinations   
  type_of_flights VARCHAR(1) [not null] //di_indicator , (domestic (D), international (I) or Schengen (S))
  departure_time_scheduled_utc DATETIME [not null] //departure_time__schedule_utc
  departure_time_estimated_utc DATETIME //departure_time_estimated_utc
  departure_time_actual_utc DATETIME //departure_time__actual_utc
  terminal VARCHAR(2) //location_and_status__terminal
}

Table dim_airline {
  airline_id VARCHAR [primary key, unique]
  airline_name VARCHAR 
  iata_code VARCHAR(2) 
  icao_code VARCHAR(3)
  country_region VARCHAR
}

Table dim_airport {
  airport_id VARCHAR [primary key, unique]
  airport_name VARCHAR 
  iata_code VARCHAR(2) 
  icao_code VARCHAR(3)
  continent VARCHAR
  country VARCHAR
  location VARCHAR
}

Table dim_date {
  date_id VARCHAR [primary key, unique]
  date DATE [not null]
  year INTEGER [not null]
  month INTEGER [not null]
  day INTEGER [not null]
  day_of_week VARCHAR [not null]
  is_weekend BOOL [not null]
}